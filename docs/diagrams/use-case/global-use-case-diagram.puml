@startuml global-use-case-knowledge-platform
' Classic academic UML use-case layout for A4 report pages.
!theme plain
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam actorFontSize 10
skinparam usecaseFontSize 9
skinparam packageFontSize 10
skinparam nodesep 16
skinparam ranksep 18
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BorderColor #333333
}
skinparam arrow {
  Color #444444
}

left to right direction
title Global use-case diagram — Knowledge Platform

' Primary actors (left)
actor Guest <<human>> as A_Guest
actor "Authenticated user" as A_Auth <<abstract>>
actor Employee <<human>> as A_Emp
actor Manager <<human>> as A_Mgr
actor Administrator <<human>> as A_Admin

A_Emp -up-|> A_Auth
A_Mgr -up-|> A_Auth
A_Admin -up-|> A_Auth

A_Guest -[hidden]down-> A_Emp
A_Emp -[hidden]down-> A_Mgr
A_Mgr -[hidden]down-> A_Admin

' Secondary actors (right)
actor "Email (SMTP)" <<secondary>> as A_Email
actor "AI provider (Gemini)" <<secondary>> as A_AI
actor "Document processing\n(BullMQ worker)" <<secondary>> as A_Worker

A_Email -[hidden]down-> A_AI
A_AI -[hidden]down-> A_Worker

rectangle "Knowledge Platform" as SYS {
  package "Authentication and account" as P_Auth {
    usecase "Authenticate user" as UC_Login
    usecase "Refresh session" as UC_Refresh
    usecase "Manage profile and avatar" as UC_Profile
    usecase "Reset password" as UC_Reset
  }

  package "Document library and access control" as P_Doc {
    usecase "Browse and filter documents" as UC_Browse
    usecase "View / download document" as UC_Read
    usecase "Manage metadata,\nfavorites and recents" as UC_Meta
    usecase "Upload / new version\nand reprocess document" as UC_Upload
  }

  package "Search, AI and collaboration" as P_AI {
    usecase "Semantic search" as UC_Semantic
    usecase "Ask assistant (RAG stream)" as UC_Ask
    usecase "Manage conversations" as UC_Conv
    usecase "Submit answer feedback" as UC_Feedback
  }

  package "Notifications and governance" as P_Gov {
    usecase "Browse notifications" as UC_NotifInbox
    usecase "Send manual notification" as UC_NotifSend
    usecase "Manager dashboard" as UC_MgrDash
    usecase "Admin users/departments,\nstats and audit" as UC_Admin
  }

  usecase "View restricted-feature page" as UC_Restricted
}

' Guest (unauthenticated)
A_Guest --> UC_Login
A_Guest --> UC_Reset

' Shared authenticated use cases (inherited by Employee, Manager, Administrator)
A_Auth --> UC_Refresh
A_Auth --> UC_Profile
A_Auth --> UC_Browse
A_Auth --> UC_Read
A_Auth --> UC_Meta
A_Auth --> UC_Semantic
A_Auth --> UC_Ask
A_Auth --> UC_Conv
A_Auth --> UC_Feedback
A_Auth --> UC_NotifInbox
A_Auth --> UC_Restricted
A_Auth --> UC_MgrDash

' Role-specific additions
A_Mgr --> UC_Upload
A_Mgr --> UC_NotifSend

A_Admin --> UC_Upload
A_Admin --> UC_NotifSend
A_Admin --> UC_Admin

' Include / extend relations (classic UML style)
UC_Ask .> UC_Semantic : <<include>>
UC_Conv .> UC_Ask : <<include>>
UC_Read .> UC_Browse : <<include>>
UC_Upload .> UC_Meta : <<include>>
UC_NotifSend .> UC_NotifInbox : <<extend>>
UC_Restricted .> UC_Browse : <<extend>>
UC_Restricted .> UC_Ask : <<extend>>

' External system interactions
UC_Reset ..> A_Email : <<notify>>
UC_Login ..> A_Email : <<notify>>
UC_Semantic ..> A_AI : <<invoke>>
UC_Ask ..> A_AI : <<invoke>>
UC_Upload ..> A_Worker : <<enqueue>>

@enduml
