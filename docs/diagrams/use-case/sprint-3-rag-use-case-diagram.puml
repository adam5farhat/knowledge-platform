@startuml sprint-3-use-case-knowledge-platform
!theme plain
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam actorFontSize 10
skinparam usecaseFontSize 9
skinparam nodesep 14
skinparam ranksep 16
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam actor {
  BorderColor #333333
}

left to right direction
title Sprint 3 use-case diagram — Search, RAG and conversations

actor "Authenticated user" as A_Auth <<abstract>>
actor Employee <<human>> as A_Emp
actor Manager <<human>> as A_Mgr
actor Administrator <<human>> as A_Admin

A_Emp -up-|> A_Auth
A_Mgr -up-|> A_Auth
A_Admin -up-|> A_Auth
A_Emp -[hidden]down-> A_Mgr
A_Mgr -[hidden]down-> A_Admin

actor "AI provider (Gemini)" <<secondary>> as A_AI

rectangle "Sprint 3 — Search, RAG and conversations" as SYS {
  usecase "Semantic search" as UC_Semantic
  usecase "Ask assistant (RAG stream)" as UC_Ask
  usecase "Manage conversations" as UC_Conv
  usecase "Submit answer feedback" as UC_Feedback
  usecase "View feedback analytics" as UC_Stats
}

A_Auth --> UC_Semantic
A_Auth --> UC_Ask
A_Auth --> UC_Conv
A_Auth --> UC_Feedback
A_Admin --> UC_Stats

UC_Ask .> UC_Semantic : <<include>>
UC_Conv .> UC_Ask : <<include>>
UC_Semantic ..> A_AI : <<invoke>>
UC_Ask ..> A_AI : <<invoke>>

@enduml
